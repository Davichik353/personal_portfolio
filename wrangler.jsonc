{
  "name": "personal-portfolio",
  "main": "website/analytics-worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./website/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/telegram-click"]
  },
  "analytics_engine_datasets": [
    { "binding": "PORTFOLIO_ANALYTICS", "dataset": "portfolio_telegram_clicks" }
  ]
}
